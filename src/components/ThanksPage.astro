---
// Сторінка «Дякуємо» — для відправки форми без JavaScript
import Base from '../layouts/Base.astro';
import Mark from './Mark.astro';
import { contacts, getContent, localePath, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { form } = getContent(lang).ui;
---
<Base lang={lang} title={`${form.thanksTitle} — teamdor`} noindex>
  <section class="wrap thanks">
    <Mark class="t-mark" />
    <h1>{form.thanksTitle}</h1>
    <p>{form.thanksText}</p>
    <div class="btns">
      <a class="btn" href={contacts.telegram} target="_blank" rel="noopener">{form.thanksTelegram}</a>
      <a class="btn btn--ghost" href={localePath(lang, '/')}>{form.thanksHome}</a>
    </div>
  </section>
</Base>

<style>
  .thanks { min-height: 70svh; display: grid; place-content: center; justify-items: center; text-align: center; gap: 20px; padding-block: 80px; }
  .thanks :global(.t-mark) { width: 64px; height: 84px; }
  h1 { font-size: clamp(3rem, 8vw, 6rem); }
  p { font-size: 22px; color: var(--ink-2); }
  .btns { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; margin-top: 12px; }
</style>
