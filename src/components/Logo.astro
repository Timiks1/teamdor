---
// Горизонтальний логотип: двері + «teamdor» малими. Смуга світла завжди праворуч.
interface Props {
  href?: string;
  inverse?: boolean;
  animated?: boolean;
  label?: string;
}
const { href = '/', inverse = false, animated = false, label = 'teamdor — на головну' } = Astro.props;
---
<a href={href} class:list={['logo', { 'logo--inverse': inverse, 'logo--animated': animated }]} aria-label={label}>
  <svg class="logo-door" viewBox="0 0 30 40" aria-hidden="true">
    <rect class="logo-leaf" x="2" y="2" width="20" height="36" rx="2.5" />
    <rect class="logo-knob" x="16" y="19" width="2.5" height="4" rx="1.2" />
    <rect class="logo-light" x="24.5" y="2" width="4" height="36" rx="1.4" />
  </svg>
  <span class="logo-word">teamdor</span>
</a>

<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; color: var(--ink); line-height: 1; }
  .logo:hover { color: var(--ink); }
  .logo-door { width: 22px; height: 30px; overflow: visible; transform-origin: 50% 100%; }
  .logo-leaf { fill: var(--night); }
  .logo-knob { fill: var(--paper); }
  .logo-light { fill: #C9C3B8; transition: fill .25s, filter .25s; }
  .logo-word { font-family: var(--font-display); font-weight: 700; font-size: 28px; letter-spacing: -0.035em; padding-bottom: 3px; }

  .logo--inverse { color: var(--paper); }
  .logo--inverse:hover { color: var(--paper); }
  .logo--inverse .logo-leaf { fill: var(--paper); }
  .logo--inverse .logo-knob { fill: var(--night); }
  .logo--inverse .logo-light { fill: #3A4458; }

  /* Світло загорається при наведенні */
  .logo:hover .logo-light, .logo:focus-visible .logo-light, .logo.is-lit .logo-light {
    fill: var(--beam);
    filter: drop-shadow(0 0 4px var(--glow)) drop-shadow(0 0 10px rgba(127, 176, 255, .8));
  }

  /* «Лампа Pixar»: двері застрибують на місце, загоряються і гаснуть */
  .logo--animated .logo-door { animation: door-hop 1.1s var(--ease-out) .15s both; }
  .logo--animated .logo-light { animation: door-light 1.5s ease 1.05s both; }

  @keyframes door-hop {
    0% { transform: translateY(-22px) scale(.9, 1.1); opacity: 0; }
    30% { transform: translateY(0) scale(1.14, .82); opacity: 1; }
    48% { transform: translateY(-7px) scale(.94, 1.07); }
    64% { transform: translateY(0) scale(1.05, .94); }
    80% { transform: translateY(-1.5px) scale(.99, 1.01); }
    100% { transform: none; }
  }
  @keyframes door-light {
    0%, 100% { fill: #C9C3B8; filter: none; }
    12% { fill: var(--beam); filter: drop-shadow(0 0 6px var(--glow)) drop-shadow(0 0 14px rgba(127, 176, 255, .9)); }
    18% { fill: #9DB9EE; filter: drop-shadow(0 0 2px var(--glow)); }
    26%, 70% { fill: var(--beam); filter: drop-shadow(0 0 6px var(--glow)) drop-shadow(0 0 14px rgba(127, 176, 255, .9)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo--animated .logo-door, .logo--animated .logo-light { animation: none; }
  }
</style>
