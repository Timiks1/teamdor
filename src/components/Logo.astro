---
// Горизонтальний логотип: знак + «teamdor» малими (Fixel Display Medium, трекінг −2).
// glow — світло в знаку розгоряється, коли курсор наближається до логотипа.
import Mark from './Mark.astro';

interface Props {
  href?: string;
  inverse?: boolean;
  glow?: boolean;
  label?: string;
}
const { href = '/', inverse = false, glow = false, label = 'teamdor — на головну' } = Astro.props;
---
<a href={href} class:list={['logo', { 'logo--inverse': inverse, 'logo--glow': glow }]} aria-label={label} data-logo-glow={glow ? '' : undefined}>
  <Mark class="logo-mark" spill={glow} />
  <span class="logo-word">teamdor</span>
</a>

<style>
  .logo { --g: 0; display: inline-flex; align-items: center; gap: 10px; min-height: 44px; text-decoration: none; color: var(--ink); line-height: 1; }
  .logo:hover { color: var(--ink); }
  .logo :global(.logo-mark) { width: 26px; height: 34px; flex: none; }
  .logo-word { font-family: var(--font-display); font-weight: 500; font-size: 30px; letter-spacing: -0.02em; padding-bottom: 4px; }
  .logo--inverse, .logo--inverse:hover { color: var(--paper); }

  /* Свічення: інтенсивність --g (0…1) задає скрипт залежно від відстані до курсора */
  .logo--glow :global(.mark-light) {
    filter: drop-shadow(0 0 calc(1px + var(--g) * 7px) rgba(127, 176, 255, calc(var(--g) * 1)))
            drop-shadow(0 0 calc(var(--g) * 16px) rgba(127, 176, 255, calc(var(--g) * .7)));
  }
  .logo--glow :global(.mark-spill) { opacity: calc(var(--g) * .85); }

  /* Поява: світло «наливається» знизу вгору, як у фірмовому лоадері */
  .logo--glow :global(.mark-light) { transform-box: fill-box; transform-origin: 50% 100%; animation: light-in .9s cubic-bezier(.4, 0, .2, 1) .2s both; }
  @keyframes light-in { from { transform: scaleY(0); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .logo--glow :global(.mark-light) { animation: none; } }
</style>

<script>
  const logos = [...document.querySelectorAll<HTMLElement>('[data-logo-glow]')];
  if (logos.length) {
    const RADIUS = 320; // px — з якої відстані починає світитися
    let px = -1e4, py = -1e4, raf = 0;
    const paint = () => {
      raf = 0;
      logos.forEach((el) => {
        const light = el.querySelector('.mark-light');
        if (!light) return;
        const r = light.getBoundingClientRect();
        const d = Math.hypot(px - (r.left + r.width / 2), py - (r.top + r.height / 2));
        const g = Math.max(0, 1 - d / RADIUS);
        el.style.setProperty('--g', (g * g * (3 - 2 * g)).toFixed(3));
      });
    };
    const queue = () => { if (!raf) raf = requestAnimationFrame(paint); };

    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      window.addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; queue(); }, { passive: true });
      window.addEventListener('scroll', queue, { passive: true });
      document.addEventListener('pointerleave', () => { px = py = -1e4; queue(); });
    } else {
      // Сенсорні екрани: курсора немає — світло спалахує при появі й при дотику
      const flash = (el: HTMLElement) => {
        el.animate([{ '--g': 0 }, { '--g': 1, offset: 0.35 }, { '--g': 0 }] as Keyframe[], { duration: 1400, easing: 'ease-out' });
      };
      logos.forEach((el) => {
        setTimeout(() => flash(el), 1000);
        el.addEventListener('touchstart', () => flash(el), { passive: true });
      });
    }
  }
</script>
