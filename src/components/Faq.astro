---
import { getContent, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { faq } = getContent(Astro.props.lang);
const visible = faq.visibleCount ?? 6;
const hasMore = faq.items.length > visible;
---
<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap grid">
    <div class="head reveal">
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2 id="faq-title">{faq.title}</h2>
    </div>
    <div class="list" data-faq>
      {faq.items.map((it, i) => (
        <details class="qa" data-extra={i >= visible ? '' : undefined} hidden={i >= visible}>
          <summary><span>{it.q}</span><i aria-hidden="true"></i></summary>
          <div class="a"><p>{it.a}</p></div>
        </details>
      ))}
      {hasMore && (
        <button type="button" class="btn btn--ghost more" aria-expanded="false" data-faq-more data-more={faq.moreLabel} data-less={faq.lessLabel}>
          <span class="lbl">{faq.moreLabel}</span> <span class="count">+{faq.items.length - visible}</span>
        </button>
      )}
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.items.map((it) => ({ '@type': 'Question', name: it.q, acceptedAnswer: { '@type': 'Answer', text: it.a } })),
})} />

<style>
  .grid { display: grid; grid-template-columns: 4fr 8fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .head { position: sticky; top: calc(var(--header-h) + 40px); }
  .list { border-top: 1px solid var(--line); }
  .qa { border-bottom: 1px solid var(--line); }
  .qa summary {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    min-height: 80px; padding-block: 20px; cursor: pointer; list-style: none;
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.25rem, 2vw, 1.5rem); line-height: 1.3;
  }
  .qa summary::-webkit-details-marker { display: none; }
  .qa summary:hover { color: var(--beam-deep); }
  .qa i { position: relative; flex: none; width: 40px; height: 40px; border-radius: 50%; background: var(--sand); transition: background .2s, transform .3s var(--ease-out); }
  .qa i::before, .qa i::after { content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px; background: var(--ink); border-radius: 2px; transform: translate(-50%, -50%); }
  .qa i::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform .3s var(--ease-out); }
  .qa[open] i { background: var(--ink); transform: rotate(180deg); }
  .qa[open] i::before, .qa[open] i::after { background: var(--paper); }
  .qa[open] i::after { transform: translate(-50%, -50%) rotate(0deg); }
  .a { padding: 0 64px 28px 0; color: var(--ink-2); max-width: 62ch; }
  .more { margin-top: 32px; }
  .count { color: var(--ink-2); font-weight: 500; }
  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; }
    .head { position: static; }
    .a { padding-right: 0; }
    .more { width: 100%; }
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-faq-more]');
  if (btn) {
    const extras = [...document.querySelectorAll<HTMLElement>('[data-faq] [data-extra]')];
    const count = btn.querySelector('.count');
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      extras.forEach((el) => (el.hidden = !open));
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('.lbl')!.textContent = (open ? btn.dataset.less : btn.dataset.more) ?? '';
      if (count) (count as HTMLElement).hidden = open;
      if (open) extras[0]?.querySelector('summary')?.focus();
    });
  }
</script>
