---
import DoorIcon from './DoorIcon.astro';
import { getContent, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { hero } = getContent(lang).home;
const lines = hero.title.split(/(?<=[.!?])\s+/);

// Знак-арка (геометрія знака × K); при наведенні на смугу світла навколо неї розгоряється ореол, як від лампи
const K = 5.4, CX = 1290, BASE = 703;
const bar = { x: CX + 7 * K, w: 13 * K, h: 52 * K };
const bx = bar.x + bar.w / 2, by = BASE - bar.h / 2;
const archD = `M${CX - 28 * K},${BASE} L${CX - 28 * K},${BASE - 46 * K} A${28 * K},${28 * K} 0 0 1 ${CX + 28 * K},${BASE - 46 * K} L${CX + 28 * K},${BASE}`;
---
<section class="hero" id="top" data-hero>
  <div class="hero-bg" aria-hidden="true">
    <svg viewBox="0 0 1600 1000" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="lamp-wide">
          <stop offset="0" stop-color="#7FB0FF" stop-opacity=".7" />
          <stop offset=".25" stop-color="#7FB0FF" stop-opacity=".42" />
          <stop offset=".55" stop-color="#7FB0FF" stop-opacity=".14" />
          <stop offset="1" stop-color="#7FB0FF" stop-opacity="0" />
        </radialGradient>
        <radialGradient id="lamp-core">
          <stop offset="0" stop-color="#5C95FF" stop-opacity=".95" />
          <stop offset=".5" stop-color="#7FB0FF" stop-opacity=".45" />
          <stop offset="1" stop-color="#7FB0FF" stop-opacity="0" />
        </radialGradient>
      </defs>
      <g class="glow">
        <ellipse cx={bx} cy={by} rx="300" ry="380" fill="url(#lamp-wide)" />
        <ellipse cx={bx} cy={by} rx="90" ry="210" fill="url(#lamp-core)" />
        <ellipse cx={bx} cy={BASE + 4} rx="190" ry="28" fill="url(#lamp-core)" />
      </g>
      <g class="door">
        <path d={archD} class="arch" />
        <rect class="slit" x={bar.x} y={BASE - bar.h} width={bar.w} height={bar.h} rx={bar.w / 2} />
      </g>
    </svg>
  </div>

  <div class="wrap hero-inner">
    <h1 class="hero-title">
      {lines.map((l, i) => <span class="line" style={`--i:${i}`}>{l}</span>)}
    </h1>
    <p class="hero-lead">{hero.lead}</p>
    <div class="hero-actions">
      <a class="btn" href="#contact" data-cta="hero"><DoorIcon />{hero.primary}</a>
      <a class="btn btn--ghost" href="#pricing" data-cta="hero-prices">{hero.secondary}</a>
    </div>
    <p class="hero-note">{hero.note}</p>
  </div>
</section>

<script>
  // Як у маленького логотипа: що ближче курсор до смуги світла, то яскравіший ореол (--g від 0 до 1).
  // Смуга велика, тому відстань рахуємо до її країв: над самою смугою — повне світло.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const bar = hero?.querySelector<SVGRectElement>('.slit');
  if (hero && bar) {
    const RADIUS = 420; // px — з якої відстані починає світитися
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let px = -1e4, py = -1e4, raf = 0;
      const paint = () => {
        raf = 0;
        const r = bar.getBoundingClientRect();
        const dx = Math.max(r.left - px, 0, px - r.right);
        const dy = Math.max(r.top - py, 0, py - r.bottom);
        const g = Math.max(0, 1 - Math.hypot(dx, dy) / RADIUS);
        hero.style.setProperty('--g', (g * g * (3 - 2 * g)).toFixed(3));
      };
      const queue = () => { if (!raf) raf = requestAnimationFrame(paint); };
      window.addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; queue(); }, { passive: true });
      window.addEventListener('scroll', queue, { passive: true });
      document.addEventListener('pointerleave', () => { px = py = -1e4; queue(); });
    } else {
      // Сенсорні екрани: курсора немає — світло спалахує при появі й при дотику до смуги
      const flash = () => hero.animate([{ '--g': 0 }, { '--g': 1, offset: 0.35 }, { '--g': 0 }] as Keyframe[], { duration: 1800, easing: 'ease-out' });
      setTimeout(flash, 1000);
      window.addEventListener('pointerdown', (e) => {
        const r = bar.getBoundingClientRect();
        if (e.clientX >= r.left - 24 && e.clientX <= r.right + 24 && e.clientY >= r.top - 24 && e.clientY <= r.bottom + 24) flash();
      }, { passive: true });
    }
  }
</script>

<style>
  .hero { position: relative; isolation: isolate; min-height: calc(100svh - var(--header-h)); display: flex; align-items: center; overflow: hidden; }
  .hero-bg { position: absolute; inset: 0; z-index: -1; }
  .hero-bg svg { width: 100%; height: 100%; }
  .arch { fill: none; stroke: var(--ink); stroke-width: 30; stroke-linecap: round; }
  .slit { fill: var(--beam); }

  /* Ореол «як від лампи»: яскравість --g (0…1) залежить від відстані курсора до смуги */
  .hero { --g: 0; }
  .glow { opacity: var(--g); transform-box: fill-box; transform-origin: center; transform: scale(calc(.9 + var(--g) * .1)); }

  .hero-inner { position: relative; padding-block: clamp(56px, 9vw, 120px); }
  .hero-title { font-size: clamp(2.5rem, 8vw, 7.25rem); max-width: 11ch; }
  .line { display: block; animation: rise .9s var(--ease-out) calc(var(--i) * .09s + .1s) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(.35em); } to { opacity: 1; transform: none; } }
  .hero-lead { font-size: clamp(1.25rem, 2vw, 1.625rem); line-height: 1.45; max-width: 30ch; margin-top: clamp(28px, 4vw, 40px); color: var(--ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 36px; }
  .hero-note { margin-top: 18px; font-size: 16px; color: var(--ink-2); }

  @media (max-width: 900px) {
    .hero { align-items: flex-start; }
    .hero-bg svg { position: absolute; top: auto; bottom: 0; left: -40vw; width: 150vw; height: auto; aspect-ratio: 1600 / 1000; max-width: none; }
    .hero-inner { padding-bottom: min(60vw, 420px); }
    .hero-title { max-width: none; }
  }
  @media (max-width: 520px) {
    .hero-actions .btn { width: 100%; }
    .hero-bg svg { left: -76vw; width: 175vw; }
    .hero-inner { padding-bottom: 88vw; }
  }
  @media (prefers-reduced-motion: reduce) {
    .line { animation: none !important; }
  }
</style>
