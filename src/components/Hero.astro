---
import DoorIcon from './DoorIcon.astro';
import Mark from './Mark.astro';
import { getContent, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { lang } = Astro.props;
const { hero } = getContent(lang).home;
const lines = hero.title.split(/(?<=[.!?])\s+/);

// Знак у hero: ≈160 px на десктопі (праворуч від заголовка), ≈96 px на телефоні (над заголовком). Дод. ТЗ v0.2, п. 6.
---
<section class="hero" id="top" data-hero>
  <div class="wrap hero-inner">
    <div class="hero-mark" aria-hidden="true"><Mark class="hero-sign" glow /></div>
    <div class="hero-copy">
    <h1 class="hero-title">
      {lines.map((l, i) => <span class="line" style={`--i:${i}`}>{l}</span>)}
    </h1>
    <p class="hero-lead">{hero.lead}</p>
    <div class="hero-actions">
      <a class="btn" href="#contact" data-cta="hero"><DoorIcon />{hero.primary}</a>
      <a class="btn btn--ghost" href="#pricing" data-cta="hero-prices">{hero.secondary}</a>
    </div>
    <p class="hero-note">{hero.note}</p>
    </div>
  </div>
</section>

<script>
  // Як у маленького логотипа: що ближче курсор до смуги світла, то яскравіший ореол (--g від 0 до 1).
  // Смуга велика, тому відстань рахуємо до її країв: над самою смугою — повне світло.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const bar = hero?.querySelector<SVGRectElement>('.mark-light');
  if (hero && bar) {
    const RADIUS = 360; // px — з якої відстані починає світитися
    if (matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let px = -1e4, py = -1e4, raf = 0;
      const paint = () => {
        raf = 0;
        const r = bar.getBoundingClientRect();
        const dx = Math.max(r.left - px, 0, px - r.right);
        const dy = Math.max(r.top - py, 0, py - r.bottom);
        const g = Math.max(0, 1 - Math.hypot(dx, dy) / RADIUS);
        hero.style.setProperty('--g', (g * g * (3 - 2 * g)).toFixed(3));
      };
      const queue = () => { if (!raf) raf = requestAnimationFrame(paint); };
      window.addEventListener('pointermove', (e) => { px = e.clientX; py = e.clientY; queue(); }, { passive: true });
      window.addEventListener('scroll', queue, { passive: true });
      document.addEventListener('pointerleave', () => { px = py = -1e4; queue(); });
    } else {
      // Сенсорні екрани: курсора немає — світло спалахує при появі й при дотику до смуги
      const flash = () => hero.animate([{ '--g': 0 }, { '--g': 1, offset: 0.35 }, { '--g': 0 }] as Keyframe[], { duration: 1800, easing: 'ease-out' });
      setTimeout(flash, 1000);
      window.addEventListener('pointerdown', (e) => {
        const r = bar.getBoundingClientRect();
        if (e.clientX >= r.left - 24 && e.clientX <= r.right + 24 && e.clientY >= r.top - 24 && e.clientY <= r.bottom + 24) flash();
      }, { passive: true });
    }
  }
</script>

<style>
  .hero { --g: 0; position: relative; overflow: hidden; }
  .hero-inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: clamp(32px, 6vw, 96px); padding-block: clamp(56px, 8vw, 112px) clamp(64px, 9vw, 128px); }
  .hero-mark { order: 2; display: flex; justify-content: center; padding-right: clamp(0px, 4vw, 64px); }
  .hero-mark :global(.hero-sign) { height: 160px; width: auto; color: var(--ink); }
  /* Ореол «як від лампи»: яскравість --g (0…1) залежить від відстані курсора до смуги */
  .hero-mark :global(.mark-glow) { opacity: var(--g); }
  /* Як у маленького логотипа: при завантаженні світло «наливається» знизу вгору, один раз */
  .hero-mark :global(.mark-light) { transform-box: fill-box; transform-origin: 50% 100%; animation: light-in .9s cubic-bezier(.4, 0, .2, 1) .2s both; }
  @keyframes light-in { from { transform: scaleY(0); } to { transform: none; } }

  .hero-title { font-size: clamp(2.5rem, 7.2vw, 6.5rem); max-width: 12ch; }
  .line { display: block; animation: rise .9s var(--ease-out) calc(var(--i) * .09s + .1s) both; }
  @keyframes rise { from { opacity: 0; transform: translateY(.35em); } to { opacity: 1; transform: none; } }
  .hero-lead { font-size: clamp(1.25rem, 2vw, 1.625rem); line-height: 1.45; max-width: 30ch; margin-top: clamp(24px, 3.5vw, 36px); color: var(--ink); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 32px; }
  .hero-note { margin-top: 18px; font-size: 16px; color: var(--ink-2); }

  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; gap: 20px; padding-block: 28px 48px; }
    .hero-mark { order: -1; justify-content: flex-start; padding: 0 0 0 4px; }
    .hero-mark :global(.hero-sign) { height: 96px; }
    .hero-title { max-width: none; }
    .hero-lead { margin-top: 18px; }
    .hero-actions { margin-top: 24px; gap: 10px; }
  }
  @media (max-width: 520px) {
    .hero-actions .btn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .line, .hero-mark :global(.mark-light) { animation: none !important; }
  }
</style>
