---
// Головна: 12 блоків, по одній думці на екран.
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Pain from './Pain.astro';
import Stages from './Stages.astro';
import Services from './Services.astro';
import Directions from './Directions.astro';
import Stats from './Stats.astro';
import Pricing from './Pricing.astro';
import Cases from './Cases.astro';
import Reviews from './Reviews.astro';
import Faq from './Faq.astro';
import Contact from './Contact.astro';
import type { Lang } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Base lang={lang} onHome>
  <Hero lang={lang} />
  <Pain lang={lang} />
  <Stages lang={lang} />
  <Services lang={lang} />
  <Directions lang={lang} />
  <Stats lang={lang} />
  <Pricing lang={lang} />
  <Cases lang={lang} />
  <Reviews lang={lang} />
  <Faq lang={lang} />
  <Contact lang={lang} />
</Base>
