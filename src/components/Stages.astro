---
import DoorIcon from './DoorIcon.astro';
import { Iso, SHADES } from '../lib/iso';
import { getContent, type Lang } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { stages } = getContent(lang).home;
const steps = stages.steps;
const pad = (n: number) => String(n).padStart(2, '0');

// ——— Сцена: з лего збираються наші двері-арка; на фіналі вони прочиняються і в щілині спалахує світло ———
const g = new Iso(22);
type Group = { s: number; cls?: string; svg: string };
const groups: Group[] = [];
const add = (s: number, svg: string, cls = '') => groups.push({ s, svg, cls });
// Блок, що перефарбовується на кроці 4 (до того — сірий)
const tint = (c: string, svg: string) => `<g class="tint c-${c}">${svg}</g>`;
type P3 = [number, number, number];

// Геометрія дверей
const Z0 = 1.0;                       // верх ґанку
const XL = 2.5, XR = 8.5, PW = 1.2;   // стійки: ліва x 2.5…3.7, права x 7.3…8.5
const YB = 3.2, YF = 4.0;             // глибина арки
const ZC = 4.6;                       // центр півкола арки
const CX = (XL + XR) / 2, R = (XR - XL) / 2, r = R - PW;
const OX0 = XL + PW, OW = 2 * r;      // проріз: x 3.7…7.3

// Контур прорізу (прямокутник + півколо) у площині y
const opening = (y: number, inset = 0): P3[] => {
  const pts: P3[] = [[OX0 + inset, y, Z0], [OX0 + OW - inset, y, Z0]];
  for (let i = 0; i <= 24; i++) {
    const a = (Math.PI * i) / 24;
    pts.push([CX + (r - inset) * Math.cos(a), y, ZC + (r - inset) * Math.sin(a)]);
  }
  return pts;
};

// Полотно дверей, прочинене назовні на кут a (петлі ліворуч)
const HX = OX0 + 0.03, LW = OW - 0.06, LY = YF - 0.12, LT = 0.18;
const leaf = (deg: number) => {
  const a = (deg * Math.PI) / 180, ca = Math.cos(a), sa = Math.sin(a);
  const W = (u: number, v: number, back = 0): P3 => [HX + u * ca + back * sa, LY + u * sa - back * ca, Z0 + v];
  const hs = ZC - Z0, rad = LW / 2;
  const outline = (inset: number): P3[] => {
    const pts: P3[] = [W(inset, inset), W(LW - inset, inset)];
    for (let i = 0; i <= 20; i++) {
      const t = (Math.PI * i) / 20;
      pts.push(W(rad + (rad - inset) * Math.cos(t), hs + (rad - inset) * Math.sin(t)));
    }
    return pts;
  };
  const edge = g.face([W(LW, 0), W(LW, hs), W(LW, hs, LT), W(LW, 0, LT)], SHADES.white[2]);
  const knob: P3[] = [];
  for (let i = 0; i < 12; i++) {
    const t = (2 * Math.PI * i) / 12;
    knob.push(W(LW - 0.4 + 0.11 * Math.cos(t), 1.75 + 0.11 * Math.sin(t)));
  }
  return edge + g.face(outline(0), SHADES.white[1]) +
    `<polygon points="${g.pts(outline(0.32))}" fill="none" stroke-width=".9" opacity=".5"/>` +
    g.face(knob, '#191A1C');
};
const LEAF_ANGLES = [0, 9, 18, 26, 32, 36, 34];

// 01 — базова пластина
add(1, g.box(0, 0, 0, 11, 8, 0.5, 'sand', true), 'pz-plate');
// 02 — перші кубики по краях (задні) і ґанок-фундамент
add(2,
  tint('mist', g.box(0, 0, 0.5, 1, 1, 1, 'var', true)) + tint('sage', g.box(10, 0, 0.5, 1, 1, 1, 'var', true)) +
  tint('clay', g.box(2.0, 3.0, 0.5, 2.4, 1.8, 0.5, 'var', true)) +
  tint('sand', g.box(4.4, 3.0, 0.5, 2.2, 1.8, 0.5, 'var', true)) +
  tint('clay', g.box(6.6, 3.0, 0.5, 2.4, 1.8, 0.5, 'var', true)) +
  tint('sand', g.box(2.0, 4.8, 0.5, 2.4, 1.8, 0.5, 'var', true)) +
  tint('mist', g.box(4.4, 4.8, 0.5, 2.2, 1.8, 0.5, 'var', true)) +
  tint('sand', g.box(6.6, 4.8, 0.5, 2.4, 1.8, 0.5, 'var', true)));
// 08 — світло за дверима (у площині прорізу, позаду стійок)
const [hx, hy] = g.p(CX + 0.6, YB, ZC - 0.4);
add(8,
  `<ellipse class="pz-halo" cx="${hx.toFixed(1)}" cy="${hy.toFixed(1)}" rx="120" ry="150" fill="url(#pz-halo)" stroke="none"/>` +
  `<polygon class="pz-light" points="${g.pts(opening((YB + YF) / 2))}" fill="url(#pz-light)" stroke="none"/>`,
  'pz-glow');
// 03 — каркас: стійки з сірих цеглинок
const pillar = (x: number) => [0, 1, 2, 3].map((k) => tint('night', g.box(x, YB, Z0 + k * 0.9, PW, YF - YB, 0.9, 'var'))).join('');
add(3, pillar(XL) + pillar(XR - PW));
// 05 — арка замикає проріз: виходить силует знака
add(5, g.arch(CX, ZC, R, r, YB, YF, 'night'), 'pz-arch');
// 08 — відсвіт на ґанку
add(8,
  `<polygon class="pz-spill" points="${g.pts([[OX0 + 0.2, YF, Z0], [OX0 + OW, YF, Z0], [XR + 0.4, 6.6, Z0], [OX0 + 0.6, 6.6, Z0]])}" fill="url(#pz-spill)" stroke="none"/>`,
  'pz-glow');
// 07 — полотно дверей (кадри відчинення перемикає скрипт)
add(7, LEAF_ANGLES.map((d, i) => `<g class="leaf-f${i === 0 ? ' is-cur' : ''}${i === LEAF_ANGLES.length - 1 ? ' leaf-last' : ''}" data-f="${i}">${leaf(d)}</g>`).join(''), 'pz-leaf');
// 02 — передні кубики
add(2, tint('clay', g.box(0, 7, 0.5, 1, 1, 1, 'var', true)) + tint('mist', g.box(10, 7, 0.5, 1, 1, 1, 'var', true)));
// 06 — маленька копія «телефон» з тим самим знаком на екрані
const phoneMark = (() => {
  const X = 10.35, yc = 4.5, zb = 1.2, rr = 0.42;
  const arc: P3[] = [[X, yc - rr, zb]];
  for (let i = 0; i <= 12; i++) { const t = (Math.PI * i) / 12; arc.push([X, yc - rr * Math.cos(t), zb + 0.7 + rr * Math.sin(t)]); }
  arc.push([X, yc + rr, zb]);
  return `<polyline points="${g.pts(arc)}" fill="none" stroke-width="2.2" stroke-linecap="round"/>` +
    g.face([[X, yc + 0.08, zb], [X, yc + 0.26, zb], [X, yc + 0.26, zb + 0.95], [X, yc + 0.08, zb + 0.95]], '#0B5FFF', 'stroke="none"');
})();
add(6,
  g.box(10.0, 3.5, 0.5, 0.35, 2, 3.4, 'night') +
  g.quadX(10.35, 3.65, 5.35, 0.8, 3.7, '#FFFFFF') +
  g.quadX(10.35, 3.85, 5.15, 3.2, 3.45, SHADES.grey[2]) + phoneMark,
  'pz-phone');
// 07 — позначка «зібрано»
const [kx, ky] = g.p(11.4, -0.6, 3.4);
add(7, `<g class="pz-check" transform="translate(${kx.toFixed(1)} ${ky.toFixed(1)})"><circle r="15" fill="#FFFFFF" stroke-width="1.5"/><path d="M-6 0.5l4 4 8-9" fill="none" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"/></g>`);

// У видовий бокс потрапляють усі точки всіх кроків, тож рамка стабільна від 1 до 8
const viewBox = g.viewBox(18);
---
<section class="stages" id="stages" data-stages data-steps={steps.length} aria-labelledby="stages-title">
  <div class="track" data-track>
  <div class="pin">
    <div class="panel-text">
      <div class="pt-top">
        <p class="pt-eyebrow">{stages.eyebrow}</p>
        <h2 id="stages-title" class="sr-only">{stages.title}</h2>
      </div>
      <ol class="step-list">
        {steps.map((st, i) => (
          <li class:list={['step', { 'is-active': i === 0 }]} data-step-i={i}>
            <span class="step-num">{pad(i + 1)}</span>
            <h3 class="step-title">{st.title}</h3>
            <p class="step-text">{st.text}</p>
            {i === 2 && <p class="step-note">{stages.prepayNote}</p>}
            {i === steps.length - 1 && (
              <a class="btn step-cta" href="#contact" data-cta="stages-final"><DoorIcon />{stages.finalCta}</a>
            )}
          </li>
        ))}
      </ol>
      <div class="progress" aria-hidden="true">
        <span class="progress-count"><b data-count>01</b> / {pad(steps.length)}</span>
        <div class="dots">
          {steps.map((_, i) => <button type="button" class:list={['dot', { 'is-active': i === 0 }]} data-dot={i} tabindex="-1"><span class="sr-only">{pad(i + 1)}</span></button>)}
        </div>
      </div>
    </div>

    <div class="panel-art">
      <div class="art-card">
        <svg class="scene" viewBox={viewBox} role="img" aria-label={stages.title}>
          <defs>
            <radialGradient id="pz-halo"><stop offset="0" stop-color="#7FB0FF" stop-opacity=".95"/><stop offset="1" stop-color="#7FB0FF" stop-opacity="0"/></radialGradient>
            <linearGradient id="pz-spill" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7FB0FF" stop-opacity=".95"/><stop offset="1" stop-color="#7FB0FF" stop-opacity="0"/></linearGradient>
            <linearGradient id="pz-light" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#7FB0FF"/><stop offset=".55" stop-color="#3D82FF"/><stop offset="1" stop-color="#0B5FFF"/></linearGradient>
          </defs>
          <g stroke="#191A1C" stroke-width="1.25" stroke-linejoin="round">
            {groups.map((gr) => <g class:list={['pz-g', gr.cls]} data-s={gr.s} set:html={gr.svg} />)}
          </g>
        </svg>
      </div>
    </div>
  </div>
  </div>

  <div class="wrap more">
    <details class="more-details">
      <summary>{stages.detailsLabel}</summary>
      <ol class="more-list">
        {steps.map((st, i) => (
          <li>
            <span class="more-num">{pad(i + 1)}</span>
            <div>
              <h3>{st.title}</h3>
              <p>{st.details}</p>
              {i === 2 && <p class="more-note">{stages.prepayNote}</p>}
            </div>
          </li>
        ))}
      </ol>
    </details>
  </div>
</section>

<style>
  .stages { --pin-h: calc(100svh - var(--header-h)); position: relative; background: var(--paper); }
  .pin { display: grid; grid-template-columns: 1fr 1fr; min-height: 640px; }

  /* Ліва панель — Night */
  .panel-text {
    position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 24px;
    background: var(--night); color: var(--paper);
    padding: clamp(28px, 4vw, 56px) clamp(24px, 5vw, 72px);
  }
  .pt-eyebrow { font-size: 15px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(247, 245, 241, .7); }
  .step-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 48px; align-content: center; }
  .step-num { display: block; font-family: var(--font-display); font-weight: 600; font-size: 20px; color: rgba(247, 245, 241, .55); margin-bottom: 12px; }
  .step-title { font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1; letter-spacing: -0.035em; }
  .step-text { margin-top: 20px; font-size: clamp(1.25rem, 1.8vw, 1.625rem); line-height: 1.45; color: rgba(247, 245, 241, .88); max-width: 28ch; }
  .step-note { margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(247, 245, 241, .2); font-size: 17px; color: rgba(247, 245, 241, .72); max-width: 32ch; }
  .step-cta { margin-top: 32px; }

  .progress { display: flex; align-items: center; gap: 20px; }
  .progress-count { font-size: 15px; color: rgba(247, 245, 241, .6); font-variant-numeric: tabular-nums; min-width: 64px; }
  .progress-count b { color: var(--paper); font-weight: 600; }
  .dots { display: flex; align-items: center; gap: 8px; }
  .dot { width: 10px; height: 10px; padding: 0; border: 0; border-radius: 99px; background: rgba(247, 245, 241, .22); cursor: pointer; transition: width .35s var(--ease-out), background .35s; }
  .dot.is-done { background: rgba(247, 245, 241, .6); }
  .dot.is-active { width: 44px; background: var(--beam); box-shadow: 0 0 12px rgba(127, 176, 255, .6); }

  /* Права панель — світла, з білою карткою */
  .panel-art { display: grid; place-items: center; background: var(--sand); padding: clamp(20px, 3vw, 48px); }
  .art-card { overflow: hidden; width: 100%; height: 100%; max-height: 720px; display: grid; place-items: center; background: var(--white); border-radius: var(--radius); padding: clamp(12px, 2vw, 32px); box-shadow: 0 1px 0 var(--line); }
  .scene { width: 100%; height: 100%; max-height: 620px; overflow: visible; }

  /* Сірий каркас → кольори бренду на кроці 4 */
  .scene :global(.tint) { --t: #EFEEEB; --l: #DAD8D3; --r: #C3C1BB; }
  .scene :global(polygon), .scene :global(ellipse), .scene :global(path) { transition: fill .7s ease; }
  .is-colored .scene :global(.c-mist) { --t: #E2E7EC; --l: #CAD3DD; --r: #B1BDCB; }
  .is-colored .scene :global(.c-sand) { --t: #EDE8DF; --l: #DDD4C5; --r: #C8BDAB; }
  .is-colored .scene :global(.c-sage) { --t: #DEE5DD; --l: #C5D0C3; --r: #ABBAA8; }
  .is-colored .scene :global(.c-clay) { --t: #EBDFD5; --l: #DBC8B8; --r: #C7AF9B; }
  .is-colored .scene :global(.c-night) { --t: #25324A; --l: #0C1526; --r: #060C18; }

  .pz-g { transition: opacity .5s ease, transform .75s var(--ease-spring); }
  :global(.pz-check) path { stroke: var(--beam); }
  .pz-g.pz-check-wrap { transform-origin: center; }

  .more { padding-block: 32px clamp(72px, 10vw, 128px); }
  .more-details { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .more-details summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px;
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.25rem, 2vw, 1.5rem); cursor: pointer; list-style: none;
  }
  .more-details summary::-webkit-details-marker { display: none; }
  .more-details summary::after { content: '+'; font-weight: 400; font-size: 32px; line-height: 1; }
  .more-details[open] summary::after { content: '–'; }
  .more-list { list-style: none; margin: 0; padding: 0 0 32px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 56px; }
  .more-list li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; }
  .more-num { font-family: var(--font-display); font-weight: 600; color: var(--ink-2); padding-top: 2px; }
  .more-list h3 { font-size: 1.375rem; }
  .more-list p { margin-top: 8px; color: var(--ink-2); }
  .more-note { font-weight: 600; color: var(--ink) !important; }

  /* ——— Живий режим (є JS і рух не вимкнено) ——— */
  :global(:root.motion) .track { height: calc(var(--pin-h) * 4.6); }
  :global(:root.motion) .pin { position: sticky; top: var(--header-h); height: var(--pin-h); min-height: 0; }
  :global(:root.motion) .step-list { position: relative; display: block; }
  :global(:root.motion) .step {
    position: absolute; left: 0; right: 0; top: 50%;
    opacity: 0; transform: translateY(calc(-50% + 28px)); pointer-events: none;
    transition: opacity .45s ease, transform .6s var(--ease-out);
  }
  :global(:root.motion) .step.is-past { transform: translateY(calc(-50% - 28px)); }
  :global(:root.motion) .step.is-active { opacity: 1; transform: translateY(-50%); pointer-events: auto; transition-delay: .08s; }

  /* Цеглинки падають згори й клацають на місце — без «висячих» проміжних станів */
  :global(:root.motion) .pz-g { opacity: 0; transform: translateY(-46px); }
  :global(:root.motion) .pz-g.is-on { opacity: 1; transform: none; }
  :global(:root.motion) .is-snapped .scene { animation: snap .45s ease .3s; }
  @keyframes snap { 0%, 100% { transform: none; } 40% { transform: scale(1.012); } }

  /* Полотно дверей: кадри відчинення, видно лише поточний */
  .scene :global(.leaf-f) { display: none; }
  .scene :global(.leaf-f.is-cur) { display: inline; }

  /* Світло за дверима — лише коли двері прочинились */
  .pz-g.pz-glow { transform: none !important; opacity: 0 !important; transition: opacity .8s ease; }
  .is-lit .pz-g.pz-glow { opacity: 1 !important; }
  .scene :global(.pz-halo) { opacity: .75; }
  .scene :global(.pz-spill) { opacity: .8; }

  /* Статичний режим: двері одразу прочинені й світяться */
  :global(:root:not(.motion)) .pz-g.pz-glow { opacity: 1 !important; }
  :global(:root:not(.motion)) .scene :global(.leaf-f.is-cur) { display: none; }
  :global(:root:not(.motion)) .scene :global(.leaf-f.leaf-last) { display: inline; }
  :global(:root:not(.motion)) .scene :global(.tint.c-mist) { --t: #E2E7EC; --l: #CAD3DD; --r: #B1BDCB; }
  :global(:root:not(.motion)) .scene :global(.tint.c-sand) { --t: #EDE8DF; --l: #DDD4C5; --r: #C8BDAB; }
  :global(:root:not(.motion)) .scene :global(.tint.c-sage) { --t: #DEE5DD; --l: #C5D0C3; --r: #ABBAA8; }
  :global(:root:not(.motion)) .scene :global(.tint.c-clay) { --t: #EBDFD5; --l: #DBC8B8; --r: #C7AF9B; }
  :global(:root:not(.motion)) .scene :global(.tint.c-night) { --t: #25324A; --l: #0C1526; --r: #060C18; }

  /* Статичний режим (без JS або «зменшити рух»): усі етапи списком, ілюстрація зібрана */
  :global(:root:not(.motion)) .progress { display: none; }
  :global(:root:not(.motion)) .step-list { gap: 40px; }
  :global(:root:not(.motion)) .step-title { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  :global(:root:not(.motion)) .step-text { font-size: 19px; margin-top: 10px; }
  :global(:root:not(.motion)) .panel-art { position: sticky; top: var(--header-h); height: calc(100svh - var(--header-h)); align-self: start; }

  @media (max-width: 900px) {
    .pin { grid-template-columns: 1fr; }
    .more-list { grid-template-columns: 1fr; }
    :global(:root.motion) .pin { grid-template-rows: minmax(0, 52%) minmax(0, 48%); }
    :global(:root.motion) .panel-text { padding: 20px 20px 18px; gap: 12px; }
    :global(:root.motion) .step-title { font-size: clamp(2rem, 9vw, 2.75rem); }
    :global(:root.motion) .step-text { font-size: 18px; margin-top: 12px; }
    :global(:root.motion) .step-note { font-size: 15px; margin-top: 10px; padding-top: 10px; }
    :global(:root.motion) .step-cta { margin-top: 16px; }
    :global(:root.motion) .step-num { margin-bottom: 6px; font-size: 17px; }
    .dot { width: 8px; height: 8px; }
    .dot.is-active { width: 28px; }
    .dots { gap: 6px; }
    .panel-art { padding: 12px; }
    .art-card { padding: 8px; }
    :global(:root:not(.motion)) .panel-art { position: static; height: auto; order: -1; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-stages]');
  const root = document.documentElement;
  if (sec && root.classList.contains('motion')) {
    const total = Number(sec.dataset.steps) || 8;
    const track = sec.querySelector<HTMLElement>('[data-track]')!;
    const pin = sec.querySelector<HTMLElement>('.pin')!;
    const stepEls = [...sec.querySelectorAll<HTMLElement>('.step')];
    const dots = [...sec.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const groups = [...sec.querySelectorAll<SVGGElement>('.pz-g')];
    const count = sec.querySelector<HTMLElement>('[data-count]')!;
    const frames = [...sec.querySelectorAll<SVGGElement>('.leaf-f')];
    let current = -1;
    let litTimer: number | undefined;

    // Двері прочиняються по кадрах, у щілині спалахує світло — виходить наш знак
    const showFrame = (f: number) => frames.forEach((el, k) => el.classList.toggle('is-cur', k === f));
    let frameTimers: number[] = [];
    const openDoor = () => {
      sec.classList.add('is-lit');
      frameTimers = frames.map((_, k) => window.setTimeout(() => showFrame(k), k * 70));
    };

    const set = (i: number) => {
      if (i === current) return;
      current = i;
      const n = i + 1;
      stepEls.forEach((el, k) => {
        el.classList.toggle('is-active', k === i);
        el.classList.toggle('is-past', k < i);
        el.setAttribute('aria-hidden', String(k !== i));
      });
      dots.forEach((d, k) => { d.classList.toggle('is-active', k === i); d.classList.toggle('is-done', k < i); });
      groups.forEach((gEl) => gEl.classList.toggle('is-on', Number(gEl.dataset.s) <= n));
      sec.classList.toggle('is-colored', n >= 4);
      sec.classList.toggle('is-snapped', n >= 7);
      clearTimeout(litTimer);
      frameTimers.forEach(clearTimeout);
      if (n >= total) litTimer = window.setTimeout(openDoor, 650);
      else { sec.classList.remove('is-lit'); showFrame(0); }
      count.textContent = String(n).padStart(2, '0');
    };

    const headerH = () => parseFloat(getComputedStyle(root).getPropertyValue('--header-h')) || 76;
    const update = () => {
      const r = track.getBoundingClientRect();
      const run = track.offsetHeight - pin.offsetHeight;
      const p = Math.min(1, Math.max(0, (headerH() - r.top) / run));
      set(Math.min(total - 1, Math.floor(p * total * 0.9999)));
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    dots.forEach((d) => d.addEventListener('click', () => {
      const i = Number(d.dataset.dot);
      const run = track.offsetHeight - pin.offsetHeight;
      const top = track.getBoundingClientRect().top + window.scrollY - headerH() + ((i + 0.5) / total) * run;
      window.scrollTo({ top, behavior: 'smooth' });
    }));
  }
</script>
