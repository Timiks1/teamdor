---
// «Етапи» (дод. ТЗ v0.2, п. 2): одна дверь збирається плавно — деталі проявляються над місцем і опускаються.
// Етапи перемикаються самі кожні 4,5 с; вручну — сегменти, стрілки, свайп, ← →.
// Сцена (three.js) вантажиться, коли блок біля екрана; до того й без WebGL — PNG того самого етапу.
import { getContent, type Lang } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { stages } = getContent(lang).home;
const steps = stages.steps;
const pad = (n: number) => String(n).padStart(2, '0');
const first = steps[0];
const data = steps.map((s, i) => ({ t: s.title, d: s.text, x: i === 2 ? stages.prepayNote : '' }));
---
<section class="stages" id="stages" aria-roledescription={stages.carouselLabel} aria-labelledby="stages-title" data-stages>
  <div class="wrap stages__wrap">
    <div class="stages__side">
      <p class="stages__eyebrow">{stages.eyebrow}</p>
      <h2 id="stages-title" class="sr-only">{stages.title}</h2>
      <div class="stages__text" aria-live="polite">
        <div class="stages__swap" data-swap>
          <p class="stages__num" data-num>01</p>
          <h3 class="stages__title" data-title>{first.title}</h3>
          <p class="stages__desc" data-desc>{first.text}</p>
          <p class="stages__extra" data-extra hidden></p>
        </div>
      </div>
      <div class="stages__bar">
        <p class="stages__count" data-count>01 <span>/ {pad(steps.length)}</span></p>
        <div class="stages__segs" role="tablist" aria-label={stages.stageLabel}>
          {steps.map((s, i) => (
            <button type="button" class="seg" role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`${i + 1}. ${s.title}`} data-seg={i + 1}><i><b></b></i></button>
          ))}
        </div>
        <div class="stages__arrows">
          <button type="button" class="arrow" aria-label={stages.prevLabel} data-prev><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg></button>
          <button type="button" class="arrow" aria-label={stages.nextLabel} data-next><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
        </div>
      </div>
    </div>

    <div class="stages__card" data-card>
      {steps.map((_, i) => (
        <img class:list={['poster', { 'is-cur': i === 0 }]} data-poster={i + 1} src={`/img/lego/stage-${i + 1}.png`} alt="" width="1200" height="900" loading="lazy" decoding="async" />
      ))}
      <canvas aria-hidden="true" data-canvas></canvas>
    </div>
  </div>

  <div class="wrap more">
    <details class="more-details">
      <summary>{stages.detailsLabel}</summary>
      <ol class="more-list">
        {steps.map((st, i) => (
          <li>
            <span class="more-num">{pad(i + 1)}</span>
            <div>
              <h3>{st.title}</h3>
              <p>{st.details}</p>
              {i === 2 && <p class="more-note">{stages.prepayNote}</p>}
            </div>
          </li>
        ))}
      </ol>
    </details>
  </div>

  <script type="application/json" data-stages-json set:html={JSON.stringify(data)} />
</section>

<style>
  .stages { background: var(--night); color: var(--paper); }
  .stages__wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 32px; align-items: center; padding-block: clamp(56px, 8vw, 96px) 32px; }
  .stages__eyebrow { font-size: 15px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(247, 245, 241, .7); margin-bottom: 28px; }
  .stages__text { position: relative; min-height: 250px; }
  .stages__swap { will-change: opacity, transform; }
  .stages__num { font-weight: 500; font-size: 17px; line-height: 1; color: rgba(247, 245, 241, .6); margin-bottom: 14px; }
  .stages__title { font-family: var(--font-display); font-weight: 600; font-size: clamp(2rem, 3.6vw, 2.75rem); line-height: 1.08; letter-spacing: -0.025em; margin-bottom: 14px; text-wrap: balance; }
  .stages__desc { font-size: 19px; line-height: 1.55; color: #DCE1EB; max-width: 34ch; }
  .stages__extra { font-size: 17px; color: rgba(247, 245, 241, .7); margin-top: 12px; }

  .stages__bar { display: flex; align-items: center; gap: 16px; margin-top: 36px; }
  .stages__count { font-weight: 600; font-size: 16px; line-height: 1; min-width: 56px; font-variant-numeric: tabular-nums; }
  .stages__count :global(span) { color: rgba(247, 245, 241, .6); font-weight: 500; }
  .stages__segs { display: flex; gap: 6px; flex: 1; }
  .seg { flex: 1; height: 44px; padding: 0; border: 0; background: none; cursor: pointer; display: flex; align-items: center; touch-action: manipulation; }
  .seg i { position: relative; display: block; width: 100%; height: 4px; border-radius: 2px; background: #2A3757; overflow: hidden; }
  .seg b { position: absolute; inset: 0; background: var(--beam); transform-origin: 0 50%; transform: scaleX(0); }
  .seg.is-done b { transform: scaleX(1); background: #FFFFFF; }
  .stages__arrows { display: flex; gap: 8px; }
  .arrow { width: 44px; height: 44px; border-radius: 999px; border: 1px solid #2A3757; background: transparent; color: #fff; cursor: pointer; display: grid; place-items: center; touch-action: manipulation; transition: background-color .15s ease, transform .16s cubic-bezier(.23, 1, .32, 1); }
  .arrow:active { transform: scale(.96); }
  .arrow svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  @media (hover: hover) and (pointer: fine) { .arrow:hover { background: #1A2645; } }

  .stages__card { position: relative; background: #FFFFFF; border-radius: 24px; aspect-ratio: 4 / 3; overflow: hidden; min-width: 0; max-width: 100%; touch-action: pan-y; }
  .stages__card canvas, .poster { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .poster { object-fit: contain; opacity: 0; transition: opacity .5s ease; }
  .poster.is-cur { opacity: 1; }
  .stages__card canvas { opacity: 0; transition: opacity .3s ease; }
  .stages__card.is-live canvas { opacity: 1; }
  .stages__card.is-live .poster { opacity: 0; }
  /* Без JS — зібрані двері */
  :global(:root:not(.js)) .poster { opacity: 0; }
  :global(:root:not(.js)) .poster[data-poster='8'] { opacity: 1; }

  .more { padding-block: 24px clamp(56px, 8vw, 96px); }
  .more-details { border-top: 1px solid #2A3757; border-bottom: 1px solid #2A3757; }
  .more-details summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px;
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.25rem, 2vw, 1.5rem); cursor: pointer; list-style: none;
  }
  .more-details summary::-webkit-details-marker { display: none; }
  .more-details summary::after { content: '+'; font-weight: 400; font-size: 32px; line-height: 1; }
  .more-details[open] summary::after { content: '–'; }
  .more-list { list-style: none; margin: 0; padding: 0 0 32px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 56px; }
  .more-list li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; }
  .more-num { font-family: var(--font-display); font-weight: 600; color: rgba(247, 245, 241, .6); padding-top: 2px; }
  .more-list h3 { font-size: 1.375rem; }
  .more-list p { margin-top: 8px; color: #DCE1EB; }
  .more-note { font-weight: 600; color: var(--paper) !important; }

  @media (max-width: 900px) {
    .stages__wrap { grid-template-columns: 1fr; gap: 20px; padding-top: 48px; }
    .stages__text { min-height: 210px; }
    .stages__eyebrow { margin-bottom: 18px; }
    .stages__bar { margin-top: 16px; gap: 12px; }
    .stages__card { border-radius: 20px; }
    .more-list { grid-template-columns: 1fr; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-stages]');
  if (sec) {
    const STEP_MS = 4500;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const data: { t: string; d: string; x: string }[] = JSON.parse(sec.querySelector('[data-stages-json]')!.textContent || '[]');
    const total = data.length;
    const $ = <T extends Element = HTMLElement>(s: string) => sec.querySelector<T>(s)!;
    const swap = $('[data-swap]');
    const segs = [...sec.querySelectorAll<HTMLButtonElement>('[data-seg]')];
    const posters = [...sec.querySelectorAll<HTMLImageElement>('[data-poster]')];
    const card = $('[data-card]');
    const canvas = $<HTMLCanvasElement>('[data-canvas]');
    const pad = (n: number) => String(n).padStart(2, '0');
    const next = () => (stage === total ? 1 : stage + 1);
    const prev = () => (stage === 1 ? total : stage - 1);

    let stage = 1;
    let door: { goTo: (n: number, o?: { instant?: boolean }) => void } | null = null;

    const paint = (n: number) => {
      const s = data[n - 1];
      $('[data-num]').textContent = pad(n);
      $('[data-title]').textContent = s.t;
      $('[data-desc]').textContent = s.d;
      const extra = $('[data-extra]');
      extra.hidden = !s.x; extra.textContent = s.x;
      $('[data-count]').innerHTML = `${pad(n)} <span>/ ${pad(total)}</span>`;
      segs.forEach((b, i) => {
        b.classList.toggle('is-done', i + 1 < n);
        b.setAttribute('aria-selected', String(i + 1 === n));
        b.querySelector('b')!.style.transform = i + 1 < n ? 'scaleX(1)' : 'scaleX(0)';
      });
      posters.forEach((p, i) => p.classList.toggle('is-cur', i + 1 === n));
    };

    // Текст: старий іде вгору на 8 px і тане за 160 мс, новий приходить знизу за 320 мс
    const showText = (from: number, to: number) => {
      if (reduce || !swap.animate) { paint(to); return; }
      const dir = to > from || (from === total && to === 1) ? 1 : -1;
      swap.animate([{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: `translateY(${-8 * dir}px)` }], { duration: 160, easing: 'ease-in', fill: 'forwards' })
        .finished.then(() => {
          paint(to);
          swap.animate([{ opacity: 0, transform: `translateY(${10 * dir}px)` }, { opacity: 1, transform: 'translateY(0)' }], { duration: 320, easing: 'cubic-bezier(0.23,1,0.32,1)', fill: 'forwards' });
        });
    };

    const goTo = (n: number) => {
      if (n === stage) return;
      const from = stage; stage = n;
      showText(from, n);
      door?.goTo(n);
    };

    // Автоперемикання: таймер іде, лише коли блок на екрані й не під курсором / фокусом
    let elapsed = 0, last = 0, paused = false, visible = false, raf = 0;
    const tick = (now: number) => {
      raf = 0;
      if (paused || !visible) return;
      elapsed += now - last; last = now;
      const k = Math.min(1, elapsed / STEP_MS);
      const bar = segs[stage - 1]?.querySelector('b');
      if (bar) bar.style.transform = `scaleX(${k})`;
      if (k >= 1) { elapsed = 0; goTo(next()); }
      raf = requestAnimationFrame(tick);
    };
    const run = () => { if (!raf && visible && !paused) { last = performance.now(); raf = requestAnimationFrame(tick); } };
    const user = (n: number) => { elapsed = 0; goTo(n); };

    segs.forEach((b) => b.addEventListener('click', () => user(Number(b.dataset.seg))));
    $('[data-prev]').addEventListener('click', () => user(prev()));
    $('[data-next]').addEventListener('click', () => user(next()));
    sec.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') paused = true; });
    sec.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') { paused = false; run(); } });
    sec.addEventListener('focusin', () => { paused = true; });
    sec.addEventListener('focusout', (e) => { if (!sec.contains(e.relatedTarget as Node)) { paused = false; run(); } });
    sec.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') user(next());
      if (e.key === 'ArrowLeft') user(prev());
    });
    // Свайп по картинці (≥ 40 px по горизонталі)
    let sx: number | null = null, sy = 0;
    card.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; });
    card.addEventListener('pointerup', (e) => {
      if (sx === null) return;
      const dx = e.clientX - sx, dy = e.clientY - sy; sx = null;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) user(dx < 0 ? next() : prev());
    });

    new IntersectionObserver(([en]) => { visible = en.isIntersecting; run(); }, { threshold: 0.35 }).observe(sec);

    // Сцена з деталями — коли блок наближається до екрана
    const lazy = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      lazy.disconnect();
      const { mountDoor } = await import('../lib/lego/door.js');
      door = mountDoor(canvas, card);
      if (!door) return; // без WebGL лишаються PNG
      door.goTo(stage, { instant: true });
      requestAnimationFrame(() => card.classList.add('is-live'));
    }, { rootMargin: '600px 0px' });
    lazy.observe(sec);
  }
</script>
