---
import DoorIcon from './DoorIcon.astro';
import { getContent, type Lang } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const { stages } = getContent(lang).home;
const steps = stages.steps;
const pad = (n: number) => String(n).padStart(2, '0');

// ——— Ілюстрація: кадри-«інструкція LEGO» (8 кроків + фінал), поверх — живе світло від синьої смуги ———
// Кадри обрізані до спільної рамки 1298×1442; координати світла — у цій системі.
const FRAMES = ['step-1', 'step-2', 'step-3', 'step-4', 'step-5', 'step-6', 'step-7', 'step-8', 'final'];
const img = (name: string, w: 700 | 1200) => `/img/stages/${name}-${w}.png`;
const VW = 1298, VH = 1442;
const BAR = { x0: 820, x1: 915, top: 569, bottom: 1005, cx: 867.5 }; // відкрита частина смуги (нижче її частково закриває телефон)
const LIGHT_FROM = 7; // з якого кроку в кадрі є синя смуга
---
<section class="stages" id="stages" data-stages data-steps={steps.length} data-light-from={LIGHT_FROM} aria-labelledby="stages-title">
  <div class="track" data-track>
  <div class="pin">
    <div class="panel-text">
      <div class="pt-top">
        <p class="pt-eyebrow">{stages.eyebrow}</p>
        <h2 id="stages-title" class="sr-only">{stages.title}</h2>
      </div>
      <ol class="step-list">
        {steps.map((st, i) => (
          <li class:list={['step', { 'is-active': i === 0 }]} data-step-i={i}>
            <span class="step-num">{pad(i + 1)}</span>
            <h3 class="step-title">{st.title}</h3>
            <p class="step-text">{st.text}</p>
            {i === 2 && <p class="step-note">{stages.prepayNote}</p>}
            {i === steps.length - 1 && (
              <a class="btn step-cta" href="#contact" data-cta="stages-final"><DoorIcon />{stages.finalCta}</a>
            )}
          </li>
        ))}
      </ol>
      <div class="progress" aria-hidden="true">
        <span class="progress-count"><b data-count>01</b> / {pad(steps.length)}</span>
        <div class="dots">
          {steps.map((_, i) => <button type="button" class:list={['dot', { 'is-active': i === 0 }]} data-dot={i} tabindex="-1"><span class="sr-only">{pad(i + 1)}</span></button>)}
        </div>
      </div>
    </div>

    <div class="panel-art">
      <div class="art-card">
        <svg class="scene" viewBox={`0 0 ${VW} ${VH}`} role="img" aria-label={stages.title} data-scene>
          <defs>
            <radialGradient id="st-wide">
              <stop offset="0" stop-color="#7FB0FF" stop-opacity=".75" />
              <stop offset=".3" stop-color="#7FB0FF" stop-opacity=".42" />
              <stop offset=".6" stop-color="#7FB0FF" stop-opacity=".14" />
              <stop offset="1" stop-color="#7FB0FF" stop-opacity="0" />
            </radialGradient>
            <radialGradient id="st-core">
              <stop offset="0" stop-color="#5C95FF" stop-opacity=".9" />
              <stop offset=".5" stop-color="#7FB0FF" stop-opacity=".4" />
              <stop offset="1" stop-color="#7FB0FF" stop-opacity="0" />
            </radialGradient>
          </defs>
          {FRAMES.map((name, i) => (
            <image
              class:list={['st-img', { 'is-cur': i === FRAMES.length - 1 }]}
              data-i={i}
              width={VW} height={VH}
              href={i === FRAMES.length - 1 ? img(name, 1200) : undefined}
              data-sm={img(name, 700)} data-lg={img(name, 1200)}
            />
          ))}
          <g class="lamp" aria-hidden="true">
            <g class="lamp-glow">
              <ellipse cx={BAR.cx} cy="800" rx="470" ry="600" fill="url(#st-wide)" />
              <ellipse cx={BAR.cx} cy="800" rx="160" ry="360" fill="url(#st-core)" />
              <ellipse cx={BAR.cx} cy="1075" rx="330" ry="70" fill="url(#st-core)" />
            </g>
            <path class="lamp-bar" d={`M${BAR.x0},${BAR.bottom} V${BAR.top + 47.5} A47.5,47.5 0 0 1 ${BAR.x1},${BAR.top + 47.5} V${BAR.bottom} Z`} />
          </g>
          <rect class="bar-hit" x={BAR.x0 - 40} y={BAR.top - 40} width={BAR.x1 - BAR.x0 + 80} height={BAR.bottom - BAR.top + 110} />
        </svg>
      </div>
    </div>
  </div>
  </div>

  <div class="wrap more">
    <details class="more-details">
      <summary>{stages.detailsLabel}</summary>
      <ol class="more-list">
        {steps.map((st, i) => (
          <li>
            <span class="more-num">{pad(i + 1)}</span>
            <div>
              <h3>{st.title}</h3>
              <p>{st.details}</p>
              {i === 2 && <p class="more-note">{stages.prepayNote}</p>}
            </div>
          </li>
        ))}
      </ol>
    </details>
  </div>
</section>

<style>
  .stages { --pin-h: calc(100svh - var(--header-h)); position: relative; background: var(--paper); }
  .pin { display: grid; grid-template-columns: 1fr 1fr; min-height: 640px; }

  /* Ліва панель — Night */
  .panel-text {
    position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 24px;
    background: var(--night); color: var(--paper);
    padding: clamp(28px, 4vw, 56px) clamp(24px, 5vw, 72px);
  }
  .pt-eyebrow { font-size: 15px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: rgba(247, 245, 241, .7); }
  .step-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 48px; align-content: center; }
  .step-num { display: block; font-family: var(--font-display); font-weight: 600; font-size: 20px; color: rgba(247, 245, 241, .55); margin-bottom: 12px; }
  .step-title { font-size: clamp(2.5rem, 5vw, 4.5rem); line-height: 1; letter-spacing: -0.035em; }
  .step-text { margin-top: 20px; font-size: clamp(1.25rem, 1.8vw, 1.625rem); line-height: 1.45; color: rgba(247, 245, 241, .88); max-width: 28ch; }
  .step-note { margin-top: 20px; padding-top: 16px; border-top: 1px solid rgba(247, 245, 241, .2); font-size: 17px; color: rgba(247, 245, 241, .72); max-width: 32ch; }
  .step-cta { margin-top: 32px; }

  .progress { display: flex; align-items: center; gap: 20px; }
  .progress-count { font-size: 15px; color: rgba(247, 245, 241, .6); font-variant-numeric: tabular-nums; min-width: 64px; }
  .progress-count b { color: var(--paper); font-weight: 600; }
  .dots { display: flex; align-items: center; gap: 8px; }
  .dot { width: 10px; height: 10px; padding: 0; border: 0; border-radius: 99px; background: rgba(247, 245, 241, .22); cursor: pointer; transition: width .35s var(--ease-out), background .35s; }
  .dot.is-done { background: rgba(247, 245, 241, .6); }
  .dot.is-active { width: 44px; background: var(--beam); box-shadow: 0 0 12px rgba(127, 176, 255, .6); }

  /* Права панель — світла, з білою карткою */
  .panel-art { display: grid; place-items: center; background: var(--sand); padding: clamp(20px, 3vw, 48px); }
  .art-card { overflow: hidden; width: 100%; height: 100%; max-height: 720px; display: grid; place-items: center; background: #FDFDFD; border-radius: var(--radius); padding: clamp(12px, 2vw, 32px); box-shadow: 0 1px 0 var(--line); }
  .scene { width: 100%; height: 100%; max-height: 640px; }

  /* Кадри змінюють один одного плавним перетіканням */
  .st-img { opacity: 0; transition: opacity .45s ease; }
  .st-img.is-cur { opacity: 1; }

  /* Світло: тонує білі поверхні (множення), чорні лінії лишає чіткими; смуга домальовується поверх, щоб не темніла */
  .lamp { opacity: 0; pointer-events: none; transition: opacity 1s ease; }
  .lamp-glow { mix-blend-mode: multiply; transform-box: fill-box; transform-origin: 50% 55%; transform: scale(.9); transition: transform .6s ease; }
  .lamp-bar { fill: #0B5FFF; }
  .is-light-on .lamp { opacity: .55; }        /* крок 7: світло вмикається */
  .is-light-full .lamp { opacity: .85; }      /* фінал: двері зібрані */
  .is-light-full.is-glow .lamp { opacity: 1; transition: opacity .45s ease-out; }
  .is-light-full.is-glow .lamp-glow { transform: scale(1.08); transition: transform .45s ease-out; }
  .bar-hit { fill: transparent; pointer-events: none; }
  .is-light-full .bar-hit { pointer-events: all; cursor: default; }

  .more { padding-block: 32px clamp(72px, 10vw, 128px); }
  .more-details { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .more-details summary {
    display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px;
    font-family: var(--font-display); font-weight: 600; font-size: clamp(1.25rem, 2vw, 1.5rem); cursor: pointer; list-style: none;
  }
  .more-details summary::-webkit-details-marker { display: none; }
  .more-details summary::after { content: '+'; font-weight: 400; font-size: 32px; line-height: 1; }
  .more-details[open] summary::after { content: '–'; }
  .more-list { list-style: none; margin: 0; padding: 0 0 32px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px 56px; }
  .more-list li { display: grid; grid-template-columns: 44px 1fr; gap: 12px; }
  .more-num { font-family: var(--font-display); font-weight: 600; color: var(--ink-2); padding-top: 2px; }
  .more-list h3 { font-size: 1.375rem; }
  .more-list p { margin-top: 8px; color: var(--ink-2); }
  .more-note { font-weight: 600; color: var(--ink) !important; }

  /* ——— Живий режим (є JS і рух не вимкнено) ——— */
  :global(:root.js) .track { height: calc(var(--pin-h) * 4.6); }
  :global(:root.js) .pin { position: sticky; top: var(--header-h); height: var(--pin-h); min-height: 0; }
  :global(:root.js) .step-list { position: relative; display: block; }
  :global(:root.js) .step {
    position: absolute; left: 0; right: 0; top: 50%;
    opacity: 0; transform: translateY(calc(-50% + 28px)); pointer-events: none;
    transition: opacity .45s ease, transform .6s var(--ease-out);
  }
  :global(:root.js) .step.is-past { transform: translateY(calc(-50% - 28px)); }
  :global(:root.js) .step.is-active { opacity: 1; transform: translateY(-50%); pointer-events: auto; transition-delay: .08s; }

  /* Без JS: одразу фінальний кадр зі світлом */
  :global(:root:not(.js)) .lamp { opacity: .85; }

  /* Статичний режим (без JS або «зменшити рух»): усі етапи списком, ілюстрація зібрана */
  :global(:root:not(.js)) .progress { display: none; }
  :global(:root:not(.js)) .step-list { gap: 40px; }
  :global(:root:not(.js)) .step-title { font-size: clamp(1.75rem, 3vw, 2.5rem); }
  :global(:root:not(.js)) .step-text { font-size: 19px; margin-top: 10px; }
  :global(:root:not(.js)) .panel-art { position: sticky; top: var(--header-h); height: calc(100svh - var(--header-h)); align-self: start; }

  @media (max-width: 900px) {
    .pin { grid-template-columns: 1fr; }
    .more-list { grid-template-columns: 1fr; }
    :global(:root.js) .pin { grid-template-rows: minmax(0, 52%) minmax(0, 48%); }
    :global(:root.js) .panel-text { padding: 20px 20px 18px; gap: 12px; }
    :global(:root.js) .step-title { font-size: clamp(2rem, 9vw, 2.75rem); }
    :global(:root.js) .step-text { font-size: 18px; margin-top: 12px; }
    :global(:root.js) .step-note { font-size: 15px; margin-top: 10px; padding-top: 10px; }
    :global(:root.js) .step-cta { margin-top: 16px; }
    :global(:root.js) .step-num { margin-bottom: 6px; font-size: 17px; }
    .dot { width: 8px; height: 8px; }
    .dot.is-active { width: 28px; }
    .dots { gap: 6px; }
    .panel-art { padding: 12px; }
    .art-card { padding: 8px; }
    :global(:root:not(.js)) .panel-art { position: static; height: auto; order: -1; }
  }
</style>

<script>
  const sec = document.querySelector<HTMLElement>('[data-stages]');
  const root = document.documentElement;
  if (sec && root.classList.contains('js')) {
    // Збирається по кроках скролу завжди; при «зменшити рух» — без падіння й переходів, блоки просто з'являються
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const total = Number(sec.dataset.steps) || 8;
    const track = sec.querySelector<HTMLElement>('[data-track]')!;
    const pin = sec.querySelector<HTMLElement>('.pin')!;
    const stepEls = [...sec.querySelectorAll<HTMLElement>('.step')];
    const dots = [...sec.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const count = sec.querySelector<HTMLElement>('[data-count]')!;
    const scene = sec.querySelector<SVGSVGElement>('[data-scene]')!;
    const imgs = [...sec.querySelectorAll<SVGImageElement>('.st-img')];
    const hit = sec.querySelector<SVGRectElement>('.bar-hit')!;
    const FINAL = imgs.length - 1;
    const LIGHT_FROM = Number(sec.dataset.lightFrom) || 7;
    let current = -1;
    let landTimer: number | undefined;

    // Кадри підвантажуються, коли блок наближається до екрана; на вузьких екранах — менші
    let loaded = false;
    const load = () => {
      if (loaded) return;
      loaded = true;
      const small = scene.getBoundingClientRect().width < 520;
      imgs.forEach((im) => im.setAttribute('href', (small ? im.dataset.sm : im.dataset.lg)!));
    };
    new IntersectionObserver((e, o) => { if (e.some((x) => x.isIntersecting)) { load(); o.disconnect(); } }, { rootMargin: '1200px 0px' }).observe(sec);

    const showImg = (k: number) => imgs.forEach((im, j) => im.classList.toggle('is-cur', j === k));

    const set = (i: number) => {
      if (i === current) return;
      current = i;
      const n = i + 1;
      stepEls.forEach((el, k) => {
        el.classList.toggle('is-active', k === i);
        el.classList.toggle('is-past', k < i);
        el.setAttribute('aria-hidden', String(k !== i));
      });
      dots.forEach((d, k) => { d.classList.toggle('is-active', k === i); d.classList.toggle('is-done', k < i); });
      count.textContent = String(n).padStart(2, '0');

      clearTimeout(landTimer);
      showImg(i);
      sec.classList.toggle('is-light-on', n >= LIGHT_FROM);
      sec.classList.remove('is-light-full', 'is-glow');
      // Крок 8: деталі декору ще «в повітрі» — за мить сідають на місце, і світло горить на повну
      if (n >= total) landTimer = window.setTimeout(() => { showImg(FINAL); sec.classList.add('is-light-full'); }, reduced ? 0 : 700);
    };

    // Наведення на синю смугу — світло розгоряється, як від лампи; на сенсорних — від дотику
    hit.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') sec.classList.add('is-glow'); });
    hit.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') sec.classList.remove('is-glow'); });
    let tapTimer: number | undefined;
    hit.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse') return;
      sec.classList.add('is-glow');
      clearTimeout(tapTimer);
      tapTimer = window.setTimeout(() => sec.classList.remove('is-glow'), 2500);
    });

    const headerH = () => parseFloat(getComputedStyle(root).getPropertyValue('--header-h')) || 76;
    const update = () => {
      const r = track.getBoundingClientRect();
      const run = track.offsetHeight - pin.offsetHeight;
      const p = Math.min(1, Math.max(0, (headerH() - r.top) / run));
      set(Math.min(total - 1, Math.floor(p * total * 0.9999)));
    };

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => { update(); ticking = false; });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    update();

    dots.forEach((d) => d.addEventListener('click', () => {
      const i = Number(d.dataset.dot);
      const run = track.offsetHeight - pin.offsetHeight;
      const top = track.getBoundingClientRect().top + window.scrollY - headerH() + ((i + 0.5) / total) * run;
      window.scrollTo({ top, behavior: 'smooth' });
    }));
  }
</script>
