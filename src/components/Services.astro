---
// «Що робимо» (дод. ТЗ v0.2, п. 3): у кожної послуги своя лего-збірка з тихим постійним рухом.
// До завантаження three.js і без WebGL видно статичну PNG того самого кадру.
import { getContent, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { services } = getContent(Astro.props.lang);
---
<section class="section services" id="services" aria-labelledby="services-title" data-lego-section>
  <div class="wrap">
    <div class="section-head head reveal">
      <div>
        <p class="eyebrow">{services.eyebrow}</p>
        <h2 id="services-title">{services.title}</h2>
      </div>
      <p class="lead">{services.text}</p>
    </div>
    <ul class="grid">
      {services.items.map((s) => (
        <li class:list={['svc', { 'svc--custom': s.icon === 'custom' }]} id={`service-${s.slug}`}>
          <div class="svc__art" data-lego-art>
            <img src={`/img/lego/svc-${s.icon}.png`} alt="" width="336" height="336" loading="lazy" decoding="async" />
            <canvas data-lego={s.icon} aria-hidden="true"></canvas>
          </div>
          <div class="svc__body">
            <h3>{s.title}</h3>
            <p>{s.text}</p>
            <a class="arrow-link" href="#contact" data-service={s.title} data-cta={`service-${s.slug}`}>
              {services.linkLabel}
              <svg viewBox="0 0 20 12" width="20" height="12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="sr-only">: {s.title}</span>
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
  .head .lead { margin-top: 0; }
  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .svc {
    position: relative; display: grid; grid-template-columns: 168px minmax(0, 1fr); gap: 18px; align-items: center;
    background: var(--sand); border-radius: 22px; padding: 18px 22px 18px 12px; min-width: 0;
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .svc--custom { background: var(--mist); }
  .svc:target { box-shadow: inset 0 0 0 2px var(--ink); }
  .svc__art { position: relative; width: 168px; aspect-ratio: 1; max-width: 100%; }
  .svc__art img, .svc__art canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .svc__art canvas { opacity: 0; transition: opacity .3s ease; }
  .svc__art.is-ready canvas { opacity: 1; }
  .svc__art.is-ready img { opacity: 0; transition: opacity .3s ease; }
  .svc h3 { font-family: var(--font-text); font-weight: 600; font-size: 21px; line-height: 1.25; letter-spacing: 0; }
  .svc p { margin: 6px 0 4px; color: var(--ink-2); font-size: 17px; line-height: 1.5; }
  .svc .arrow-link { min-height: 44px; }
  .svc .arrow-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } }
  @media (max-width: 480px) {
    .svc { grid-template-columns: 120px minmax(0, 1fr); gap: 12px; padding: 14px 16px 14px 6px; }
    .svc__art { width: 120px; }
  }
</style>

<script>
  // three.js вантажимо, лише коли блок наближається до екрана — перший екран від цього не важчає
  const section = document.querySelector<HTMLElement>('#services[data-lego-section]');
  if (section && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return;
      io.disconnect();
      const { mountShelf } = await import('../lib/lego/shelf.js');
      mountShelf([...section.querySelectorAll<HTMLCanvasElement>('canvas[data-lego]')]);
    }, { rootMargin: '300px 0px' });
    io.observe(section);
  }
</script>
