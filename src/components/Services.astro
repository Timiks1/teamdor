---
import { serviceIcon } from '../lib/iso';
import { getContent, type Lang } from '../lib/content';
interface Props { lang: Lang }
const { services } = getContent(Astro.props.lang);
---
<section class="section services" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="section-head head reveal">
      <div>
        <p class="eyebrow">{services.eyebrow}</p>
        <h2 id="services-title">{services.title}</h2>
      </div>
      <p class="lead">{services.text}</p>
    </div>
    <ul class="cards">
      {services.items.map((s, i) => (
        <li class="card reveal" id={`service-${s.slug}`} style={`transition-delay:${(i % 3) * 60}ms`}>
          <div class="art" set:html={serviceIcon(s.icon)} />
          <h3>{s.title}</h3>
          <p>{s.text}</p>
          <a class="arrow-link" href="#contact" data-service={s.title} data-cta={`service-${s.slug}`}>
            {services.linkLabel}
            <svg viewBox="0 0 20 12" width="20" height="12" aria-hidden="true"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="sr-only">: {s.title}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: flex; justify-content: space-between; align-items: end; gap: 32px; flex-wrap: wrap; }
  .head .lead { margin-top: 0; }
  .cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .card {
    position: relative; display: flex; flex-direction: column;
    background: var(--sand); border-radius: var(--radius); padding: 28px 28px 26px;
    scroll-margin-top: calc(var(--header-h) + 24px);
    transition: background .2s;
  }
  .card:hover { background: #E8E2D7; }
  .card:target { box-shadow: inset 0 0 0 2px var(--ink); }
  .art { height: 132px; display: flex; align-items: center; margin-bottom: 20px; }
  .art :global(svg) { height: 100%; width: auto; }
  .card h3 { font-size: 1.625rem; }
  .card p { margin-top: 8px; color: var(--ink-2); flex: 1; }
  .card .arrow-link { margin-top: 20px; min-height: 44px; }
  .card .arrow-link::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card:nth-child(11) { grid-column: span 1; background: var(--mist); }
  @media (max-width: 1000px) { .cards { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 620px) {
    .cards { grid-template-columns: 1fr; }
    .card { display: grid; grid-template-columns: 96px 1fr; column-gap: 18px; padding: 22px; }
    .art { grid-row: span 3; height: 88px; margin: 0; align-items: flex-start; }
    .card h3 { font-size: 1.375rem; }
    .card .arrow-link { margin-top: 10px; }
  }
</style>
