---
import Base from '../layouts/Base.astro';
import { getContent, localePath, type Lang } from '../lib/content';

interface Props {
  lang: Lang;
  entry: { frontmatter: { title: string; description?: string; updated?: string }; Content: any };
}
const { lang, entry } = Astro.props;
const { ui } = getContent(lang);
const { title, description, updated } = entry.frontmatter;
const Content = entry.Content;
const date = updated ? new Date(updated).toLocaleDateString(lang === 'uk' ? 'uk-UA' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---
<Base lang={lang} title={`${title} — teamdor`} description={description}>
  <article class="legal wrap">
    <a class="back arrow-link" href={localePath(lang, '/')}>
      <svg viewBox="0 0 20 12" width="20" height="12" aria-hidden="true" style="transform:scaleX(-1)"><path d="M1 6h17M13 1l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {ui.legal.back}
    </a>
    <h1>{title}</h1>
    {date && <p class="updated">{ui.legal.updated}: {date}</p>}
    <div class="prose"><Content /></div>
  </article>
</Base>

<style>
  .legal { max-width: 860px; padding-block: 48px 120px; }
  .back { margin-bottom: 40px; }
  .back:hover svg { transform: scaleX(-1) translateX(4px) !important; }
  h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); line-height: 1; }
  .updated { margin-top: 20px; color: var(--ink-2); }
  .prose { margin-top: 48px; }
  .prose :global(h2) { font-size: clamp(1.625rem, 3vw, 2.125rem); margin: 48px 0 16px; letter-spacing: -0.02em; }
  .prose :global(h3) { font-size: 1.375rem; margin: 32px 0 12px; }
  .prose :global(p), .prose :global(li) { color: var(--ink); }
  .prose :global(p) { margin: 0 0 16px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 16px; padding-left: 24px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 16px 0 24px; font-size: 16px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--line); vertical-align: top; }
  .prose :global(th) { background: var(--sand); }
</style>
